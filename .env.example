# ─── Banco de dados ────────────────────────────────────────────────────────
# Se vazio, o servidor usa arquivos JSON em ./data (apenas para desenvolvimento).
DATABASE_URL=

# ─── Administrador ─────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SECRET=troque-por-um-segredo-longo
# E-mail do administrador (usado pelo "Esqueci minha senha")
ADMIN_EMAIL=

# ─── Recuperação de senha por e-mail (SMTP) ────────────────────────────────
# Sem SMTP_HOST, o botão "Esqueci minha senha" informa que o recurso não está
# configurado. Funciona com Gmail (senha de app), Outlook, Brevo, SendGrid etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Painel Evoluir SST <no-reply@seudominio.com>"
# URL pública do painel, usada para montar o link do e-mail (ex.: https://painel.seudominio.com)
APP_URL=
